# Site
# Public base URL. Leave UNSET on Vercel to auto-use the deployment's *.vercel.app URL
# (production uses VERCEL_PROJECT_PRODUCTION_URL; previews use their branch URL).
# Set this only once you have a custom domain, e.g.
# https://app.yourdomain.com. In local dev it falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com

# Public support / contact address shown in the app and legal pages (privacy/terms).
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Image Generation
GEMINI_API_KEY=your-gemini-api-key

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PAY_PER_USE=price_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_BUSINESS_PRO=price_...

# Keep PAYG disabled until SQL023, meter mapping, and an hourly-or-faster retry
# scheduler are verified. The daily Vercel cron is a backstop, not that scheduler.
PAYG_METERING_ENABLED=false
PAYG_RETRY_SCHEDULE_CONFIRMED=false
# Supply a strong random value through Doppler/Vercel; never commit a real secret.
# CRON_SECRET=replace-via-secret-manager

# Email (Resend)
RESEND_API_KEY=re_...
# From-address for transactional email. Resend only sends from a VERIFIED domain; until
# you verify one, leave this unset and it falls back to Resend's onboarding@resend.dev
# sender (which can only deliver to your own Resend account email).
# EMAIL_FROM=ExteriorViz <noreply@yourdomain.com>

# Alerts (defaults to NEXT_PUBLIC_SUPPORT_EMAIL if unset)
# ADMIN_ALERT_EMAIL=you@example.com

# Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=roof-viz
# Required for readable (un-minified) stack traces in production:
# SENTRY_AUTH_TOKEN=sntrys_...
